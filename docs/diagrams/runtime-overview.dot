digraph Fieldfolio {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.30", ranksep="0.48", fontname="DejaVu Sans"];
node [shape=box, style="rounded,filled", fillcolor="#edf5ff", color="#6082ad", fontname="DejaVu Sans", fontsize=11, margin="0.16,0.10"];
edge [color="#536c88", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
Session [label="Unlocked report session",fillcolor="#d8e8ff"];
Edit [label="Native editor / DocumentViewModel\nDraft + resource ownership"];
Acode [label="Trusted Acode host\nEditorBridge"];
Save [label="ReportLibrary\nValidated packet + transaction"];
View [label="Document viewer host"];
Context [label="DocumentAccessContext\nReport snapshots + scoped resources"];
Notebook [label="Sandboxed Notebook Kit / Nexus\nNo native editor bridge"];
Coordinator [label="ResourceCoordinator\nShared GPS / weather cache"];
Session -> Edit; Session -> View;
Edit -> Acode [label="source editing"];
Acode -> Edit [label="save source"];
Edit -> Save [label="save report"];
View -> Context;
Context -> Notebook [label="read-only capabilities"];
View -> Coordinator [label="native subscriptions"];
Coordinator -> Context [label="available snapshots"];
}

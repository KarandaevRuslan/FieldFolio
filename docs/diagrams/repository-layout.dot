digraph Fieldfolio {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.30", ranksep="0.48", fontname="DejaVu Sans"];
node [shape=box, style="rounded,filled", fillcolor="#edf5ff", color="#6082ad", fontname="DejaVu Sans", fontsize=11, margin="0.16,0.10"];
edge [color="#536c88", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
Repo [label="Fieldfolio repository", fillcolor="#d8e8ff"];
App [label="MobileApp\nAndroid + web"];
Server [label="Server\nJava API + Python worker"];
Train [label="DetectionTrainProj\nDataset + training tools"];
Shared [label="Shared docs + CI\ndocs / .github / scripts / tests"];
Repo -> App; Repo -> Server; Repo -> Train; Repo -> Shared;
AppCheck [label="Python / JS / Android checks",fillcolor="#e7f5ec"];
ServerCheck [label="Maven compilation + packaging",fillcolor="#e7f5ec"];
TrainCheck [label="Python syntax checks",fillcolor="#e7f5ec"];
App -> AppCheck; Server -> ServerCheck; Train -> TrainCheck;
}

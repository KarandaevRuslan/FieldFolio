digraph Fieldfolio {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.30", ranksep="0.48", fontname="DejaVu Sans"];
node [shape=box, style="rounded,filled", fillcolor="#edf5ff", color="#6082ad", fontname="DejaVu Sans", fontsize=11, margin="0.16,0.10"];
edge [color="#536c88", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
Train [label="Dataset + YOLO training",fillcolor="#fff0d7"];
PT [label="Approved .pt weights"];
Lite [label="Validated TFLite + metadata"];
API [label="Java API\nFirebase / image validation / limits"];
Worker [label="Internal Python worker\nPOST /infer"];
Android [label="Fieldfolio Android",fillcolor="#d8e8ff"];
Local [label="Local report storage\nRoom + resource files"];
Runtime [label="Document renderer\nRead-only report VFS"];
Device [label="On-device TFLite\nConfigured model adapter"];
Train -> PT [label="evaluate"];
Train -> Lite [label="export + evaluate"];
PT -> Worker [label="manual deployment",style=dashed];
Lite -> Device [label="manual import / bundling",style=dashed];
Android -> API [label="optional authenticated HTTP(S)"];
API -> Worker [label="normalized image bytes"];
Android -> Local; Android -> Runtime; Android -> Device;
}

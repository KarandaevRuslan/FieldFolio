# Copy to MobileApp/config/keystore.properties; never commit the real properties file.
# All storeFile paths are resolved relative to MobileApp/ (not MobileApp/config/).
storeFile=config/release.keystore
storePassword=REPLACE_LOCALLY
keyAlias=REPLACE_LOCALLY
keyPassword=REPLACE_LOCALLY

# X.509 certificate subject / Owner, used by keytool ONLY when generating a NEW keystore.
# owner is the complete distinguished name. cn is its Common Name (CN) component.
# These do NOT change the subject of an existing certificate or the APK signing identity.
owner=CN=Ruslan Karandaev
cn=Ruslan Karandaev
